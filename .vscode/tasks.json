{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "开发：uv sync（建/同步 .venv）",
			"type": "process",
			"command": "uv",
			"args": [
				"sync"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "none"
		},
		{
			"label": "构建：打 wheel",
			"type": "process",
			"command": "uv",
			"args": [
				"run",
				"python",
				"scripts/build_package.py"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			// 部署 = 源码直装进隔离 tool 环境（不再装 py 主解释器，也不再依赖 wheel 文件）。
			// 用 `.` 而不是 wheel 路径：**不随版本号漂移**，升版本/改名都不用改本文件；
			// 同版本必须带 --reinstall —— 不带 flag 时 uv 只重写 exe、不重装包。
			"label": "部署：uv tool install（源码直装）",
			"type": "process",
			"command": "uv",
			"args": [
				"tool",
				"install",
				"--force",
				"--reinstall",
				"."
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "测试：门禁 pytest",
			"type": "process",
			"command": "uv",
			"args": [
				"run",
				"pytest",
				"-q"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "test"
		}
	]
}
