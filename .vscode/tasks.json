{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "开发：uv sync（建/同步 .venv）",
			"type": "process",
			"command": "uv",
			"args": [
				"sync"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "none"
		},
		{
			"label": "构建：打 wheel",
			"type": "process",
			"command": "uv",
			"args": [
				"run",
				"python",
				"scripts/build_package.py"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			// 部署 = uv tool install（隔离 tool 环境），不再装 py 主解释器。
			// ⚠️ 下面的 wheel 路径含版本号：pyproject.toml 升版本后要同步这里与 README「构建与发布」。
			"label": "部署：uv tool install（隔离 tool 环境）",
			"type": "process",
			"command": "uv",
			"args": [
				"tool",
				"install",
				"--force",
				"--reinstall",
				"scripts/output/wheels/wheelhouse/sqlfmt_ext-0.1.0/sqlfmt_ext-0.1.0-py3-none-any.whl"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "build",
			"dependsOn": [
				"构建：打 wheel"
			]
		},
		{
			"label": "测试：门禁 pytest",
			"type": "process",
			"command": "uv",
			"args": [
				"run",
				"pytest",
				"-q"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "test"
		}
	]
}
